# Copy this file to .env and fill in real values before running.
# .env is gitignored — NEVER commit real secrets.

# ---------------------------------------------------------------------------
# LLM provider chain — Groq + NVIDIA NIM (automatic fallback)
# ---------------------------------------------------------------------------
# Set keys for the providers you want. The app tries them in order and falls back
# to the next one automatically on rate-limits, timeouts, or any failure.
# If no key is set, the app runs entirely on deterministic template fallbacks.
#
# Default order: Groq → NVIDIA NIM → OpenAI
# Override with: LLM_PROVIDER_ORDER=nvidia,groq,openai
#
# --- Groq (primary, free tier at https://console.groq.com) -----------------
GROQ_API_KEY=your_groq_api_key_here
# GROQ_MODEL=llama3-8b-8192          # optional model override for Groq
#
# --- NVIDIA NIM (fallback, free tier at https://build.nvidia.com) ----------
NVIDIA_API_KEY=your_nvidia_api_key_here
# NVIDIA_MODEL=meta/llama-3.1-8b-instruct   # optional model override for NIM
#
# --- OpenAI (tertiary fallback, https://platform.openai.com) ---------------
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
#
# --- Legacy single-provider override (still respected if set) ---------------
# Setting LLM_API_BASE forces a custom endpoint as the primary provider.
# LLM_API_BASE=https://api.groq.com/openai/v1
# LLM_MODEL=llama3-8b-8192
#
# --- Shared tuning knobs ----------------------------------------------------
# LLM_TIMEOUT=5                  # seconds per attempt before falling back
# LLM_MAX_ATTEMPTS=2             # max retries per provider on transient failures
# LLM_LIVE_TOP_N=20   # 0 = no cap (every case uses LLM); >0 = top-N by amount

# ---------------------------------------------------------------------------
# Synthetic webhook pipeline secret  (REQUIRED — fail-closed)
# ---------------------------------------------------------------------------
# Used by seed.py to sign synthetic events and by webhook_security.py to verify them.
# The app REJECTS every synthetic webhook if this is unset or a known placeholder.
# Generate one:
#   python -c "import secrets; print(secrets.token_hex(32))"
WEBHOOK_SECRET=generate_a_random_64_char_hex_value_do_not_use_this_placeholder

# ---------------------------------------------------------------------------
# Razorpay (test mode — REQUIRED for real webhook intake)
# ---------------------------------------------------------------------------
# Set in Razorpay Dashboard → Settings → Webhooks → Secret.
# Used by razorpay_adapter.verify_razorpay_signature() to authenticate live events.
# Without this, any POST to /api/webhooks/razorpay returns 400 (fail-closed).
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# Razorpay API credentials (for razorpay_client.py — test-mode subscription setup).
# Get from Razorpay Dashboard → Settings → API Keys → Test Mode.
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# Optional override for the Razorpay API base URL (default shown):
# RAZORPAY_API_BASE=https://api.razorpay.com/v1

# ---------------------------------------------------------------------------
# Dashboard API key  (auto-generated if unset — see backend/security.py)
# ---------------------------------------------------------------------------
# Protects mutating endpoints: /api/seed, /api/run-agent, /api/reset, /api/simulate.
# If unset, a random key is generated at startup and printed to the server log.
# For a persistent known key (e.g. scripted demos), set one here:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
MANDATE_RESCUE_API_KEY=generate_a_strong_random_value_here

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
# LOG_LEVEL=INFO   # DEBUG | INFO | WARNING | ERROR

# ---------------------------------------------------------------------------
# Flask session key  (REQUIRED for merchant authentication)
# ---------------------------------------------------------------------------
# Used to sign the HttpOnly session cookie. Generate once and keep secret:
#   python -c "import secrets; print(secrets.token_hex(32))"
# If unset, a random key is generated per-process (sessions won't survive restarts).
FLASK_SECRET_KEY=generate_a_64_char_hex_value_here

# ---------------------------------------------------------------------------
# Merchant authentication — email / SMTP
# ---------------------------------------------------------------------------
# Provider: "simulated" (default, logs OTP to server log) or "google_smtp" (real email).
NOTIFICATION_EMAIL_PROVIDER=simulated

# Google SMTP (only required when NOTIFICATION_EMAIL_PROVIDER=google_smtp)
# Use a Google App Password — NOT your Gmail login password.
# Enable 2FA first, then create an App Password at:
#   https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your.address@gmail.com
SMTP_PASSWORD=your_google_app_password_here
MAIL_FROM=your.address@gmail.com
MAIL_FROM_NAME=Mandate Rescue
