# Copy this file to .env and fill in real values. .env is gitignored.

# LLM (Groq / OpenAI-compatible). Without a key the app runs on template fallbacks.
GROQ_API_KEY=your_key_here

# HMAC secret used to sign & verify webhook payloads. Change this in any real
# deployment; the app falls back to a placeholder default if unset (demo only).
WEBHOOK_SECRET=your_secret_here
