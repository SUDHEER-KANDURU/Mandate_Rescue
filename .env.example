# Copy this file to .env and fill in real values. .env is gitignored.

# LLM (Groq / OpenAI-compatible). Without a key the app runs on template fallbacks.
GROQ_API_KEY=your_key_here

# HMAC secret for the SYNTHETIC demo webhook pipeline (seed.py / webhook_security.py).
# This is a REQUIRED, fail-closed secret: the app will refuse to verify any webhook
# (rejecting everything) if this is unset or left as a known placeholder value.
# Generate a strong one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
WEBHOOK_SECRET=generate_a_random_64_char_hex_value_do_not_use_this_placeholder
